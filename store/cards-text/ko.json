[
  ["04-verklaringen", "스도쿠로 푸는\n*미스터리*", "누가 피해자와 단둘이 있었을까요?"],
  ["05-beschuldiging", "*범인*은\n이 안에 있다", "답은 단 하나. 감이 아니라 논리로 찾아요."],
  ["02-wereldkaart", "*끝없이*\n쏟아지는 사건", "매일 새 사건, 그리고 바닥나지 않는 기록 보관소."],
  ["06-zaak-gesloten", "사건\n*종결*", "힌트 없이 한 번에 풀면 별을 받아요."],
  ["01-thuis", "*연속 기록*을\n이어가세요", "오늘의 사건, 일일 미션, 한 주를 한눈에."],
  ["10-hint", "*설명해 주는*\n힌트", "답은 절대 말하지 않아요. 경감이 진술을 짚어 줘요."],
  ["08-nieuw", "룩소르에서\n*할리우드*까지", "월드마다 시대와 장소가 달라요. 쉬움부터 어려움까지."],
  ["09-circus", "월드마다\n새로운 *용의자*", "평면도도, 인물도, 사건도 모두 달라요."],
  ["07-vitrine", "훈장 *32*개를\n모아 보세요", "사건마다 증거품이 하나씩 진열장에 모여요."]
]
